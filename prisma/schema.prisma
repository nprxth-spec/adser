// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id                 String    @id @default(cuid())
  name               String?
  email              String?   @unique
  emailVerified      DateTime?
  image              String?
  credits            Int       @default(9999)
  plan               String    @default("free") // "free" | "pro"
  lastCreditsReset   DateTime? // last time free-plan credits were reset to 9999
  sheetId            String?
  sheetName          String?
  sheetGid           Int?     // numeric GID ของ sheet tab สำหรับลิงก์ตรงแท็บ
  sheetMapping       Json?
  filenameMapping    Json?
  filenameTemplate   Json?
  sheetProfiles      Json?
  activeSheetProfileId String?
  driveFolderId      String?
  driveFolderMode    String    @default("auto") // "auto" | "custom" | "date-subfolder"
  sheetWriteRow      Int?      // atomic row counter — avoids race conditions on concurrent uploads
  accounts           Account[]
  sessions           Session[]
  logs               ProcessingLog[]
  auditLogs          AuditLog[]
  metaConnection     MetaConnection?
  metaAdAccounts     MetaAdAccount[]
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model ProcessingLog {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  filename         String   // display name (may include mapping + billed_to)
  originalFilename String?  // name as uploaded; used for duplicate detection
  invoiceDate      String?
  cardLast4   String?
  amount      Float?
  currency    String?
  driveLink   String?
  sheetRow    Int?
  status      String   @default("success")
  pendingData Json?    // stored when status="review": { invoiceData, missingFields, driveFileId, cardPrefix, ... }
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([userId, originalFilename, status])
}

// Facebook/Meta connection for a user (one per user). Stores the long-lived
// user access token used to pull Marketing API data.
model MetaConnection {
  id             String          @id @default(cuid())
  userId         String          @unique
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  fbUserId       String
  fbUserName     String?
  accessToken    String          // long-lived user access token
  tokenExpiresAt DateTime?
  scopes         String?
  lastSyncedAt   DateTime?
  adAccounts     MetaAdAccount[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

// Ad accounts pulled from Meta and held for later sync to Google Sheets.
model MetaAdAccount {
  id            String         @id @default(cuid())
  userId        String
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  connectionId  String
  connection    MetaConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  accountId     String         // Meta ad account id (e.g. "act_123456")
  name          String?
  accountStatus Int?           // Meta numeric account_status
  timezoneName  String?
  currency      String?
  businessId    String?
  businessName  String?
  enabled       Boolean        @default(true) // user-controlled on/off per account
  raw           Json?          // full raw payload for fields we don't model yet
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@unique([userId, accountId])
  @@index([userId])
  @@index([connectionId])
}

model AuditLog {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        String   // "login" | "config_drive" | "config_sheet" | "config_naming" | "config_plan"
  description String?
  metadata    Json?    // optional extra (e.g. what changed)
  ip          String?  // client IP when available
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
  @@index([type])
}
